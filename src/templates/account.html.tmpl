{{/* The account, in a window or on its Classic page. It follows the
     Settings applet's layout. After PUDL, a passing confirmation is a toast
     (account.js raises it), and anything the reader must act on is a notice
     beside the control it concerns. */}}
{{ define "accountnotice" }}{{ with . }}<div class="notice{{ if .Kind }} {{ .Kind }}{{ end }} account-notice" role="{{ if eq .Kind "danger" "warn" }}alert{{ else }}status{{ end }}"><div class="notice-content"><p class="notice-body">{{ .Text }}</p></div></div>{{ end }}{{ end }}

{{ define "accountpanel" }}
<div class="settings-panel account-panel" data-applet="account" data-applet-page="/account?view=classic">
  {{ with .Toast }}<p data-account-toast="{{ .Kind }}" hidden>{{ .Text }}</p><noscript>{{ template "accountnotice" . }}</noscript>{{ end }}
  {{ template "accountnotice" (.NoticeAt "page") }}
  {{ if .Account }}
  <section class="card settings-card">
    <h2 class="card-title">Profile</h2>
    <table class="kv-table account-profile">
      <tbody>
        <tr><th scope="row">Signed in as</th><td>{{ .Account.Username }}</td></tr>
        <tr><th scope="row">Synchronized</th><td>Pins, collections, notes, blocked domains, and reading progress</td></tr>
        <tr><th scope="row">This browser only</th><td>Window positions and appearance</td></tr>
        <tr><th scope="row">Status</th><td role="status" data-account-sync-status>Account data loaded.</td></tr>
      </tbody>
    </table>
  </section>

  <section class="card settings-card">
    <h2 class="card-title">Profile picture</h2>
    <div class="account-identity">{{ template "avatar" .Account.AvatarURL }}
      <p class="card-desc">Shown at the top of every page while you are signed in. Any picture works; it is cropped to a square and made small before it is sent.</p>
    </div>
    {{ template "accountnotice" (.NoticeAt "picture") }}
    <form method="post" action="/account/avatar" enctype="multipart/form-data" id="account-picture-form" data-account-picture-form>
      <input type="hidden" name="return_to" value="{{ .ReturnURL }}">
      <input type="hidden" name="csrf" value="{{ .Account.CSRF }}">
      <div class="form-group">
        <label class="form-label" for="account-picture-file">Choose a picture</label>
        <input class="form-input" id="account-picture-file" type="file" name="picture" accept="image/*" required>
      </div>
    </form>
    {{/* The picture's commands share a row, each submitting its own form. */}}
    <div class="settings-actions">
      <button class="btn" type="submit" form="account-picture-form">Save picture</button>
      {{ if .Account.AvatarURL }}<form method="post" action="/account/avatar/remove">
        <input type="hidden" name="return_to" value="{{ .ReturnURL }}">
        <input type="hidden" name="csrf" value="{{ .Account.CSRF }}">
        <button class="btn" type="submit">Remove picture</button>
      </form>{{ end }}
      {{ if and .GitHubPicture (ne .Picture "github") }}<form method="post" action="/account/avatar/github">
        <input type="hidden" name="return_to" value="{{ .ReturnURL }}">
        <input type="hidden" name="csrf" value="{{ .Account.CSRF }}">
        <button class="btn" type="submit">Use my GitHub picture</button>
      </form>{{ end }}
    </div>
  </section>

  <section class="card settings-card">
    <h2 class="card-title">Ways to sign in</h2>
    <p class="card-desc">Each of these signs you in to this account, and any of them gets you back in if you lose a device, so the last one cannot be removed.</p>
    {{ template "accountnotice" (.NoticeAt "methods") }}
    <table class="kv-table account-methods">
      <tbody>
        {{ $last := eq (len .Identities) 1 }}{{ $vm := . }}
        {{ range .Identities }}<tr>
          <th scope="row">{{ if eq .Provider "github" }}GitHub{{ else }}Email{{ end }}</th>
          <td>{{ .Label }}</td>
          <td>{{ if not $last }}<form method="post" action="/account/identities/remove">
            <input type="hidden" name="return_to" value="{{ $vm.ReturnURL }}">
            <input type="hidden" name="csrf" value="{{ $vm.Account.CSRF }}">
            <input type="hidden" name="provider" value="{{ .Provider }}">
            <input type="hidden" name="subject" value="{{ .Subject }}">
            <button class="btn btn-sm" type="submit" aria-label="Remove {{ .Label }}">Remove</button>
          </form>{{ end }}</td>
        </tr>{{ end }}
      </tbody>
    </table>
    {{ if and .LoginAvailable (not .HasGitHub) }}<form method="post" action="/auth/github">
      <input type="hidden" name="return_to" value="{{ .ReturnURL }}">
      <input type="hidden" name="csrf" value="{{ .Account.CSRF }}">
      <input type="hidden" name="link" value="1">
      <div class="settings-actions"><button class="btn" type="submit">Add your GitHub account</button></div>
    </form>{{ end }}
    {{ if .EmailAvailable }}<form method="post" action="/auth/email">
      <input type="hidden" name="return_to" value="{{ .ReturnURL }}">
      <input type="hidden" name="csrf" value="{{ .Account.CSRF }}">
      <input type="hidden" name="link" value="1">
      <div class="form-group">
        <label class="form-label" for="account-add-email">Add an email address</label>
        <input class="form-input" id="account-add-email" type="email" name="email" autocomplete="email" maxlength="254" required{{ if eq .Message.Kind "danger" }}{{ if eq .Message.Place "email" }} aria-invalid="true" aria-describedby="account-email-notice"{{ end }}{{ end }}>
        <p class="form-help">YAVCHN sends a link to the address. Open it in this browser to add it.</p>
      </div>
      <div class="settings-actions"><button class="btn" type="submit">Send the link</button></div>
      <div id="account-email-notice">{{ template "accountnotice" (.NoticeAt "email") }}</div>
    </form>{{ end }}
  </section>

  {{ if .PasskeysAvailable }}<section class="card settings-card" data-passkeys>
    <h2 class="card-title">Passkeys</h2>
    <p class="card-desc">A passkey signs you in with this device's own lock, such as Windows Hello, Touch ID, your phone's screen lock, or a security key.</p>
    {{ if .Passkeys }}<table class="kv-table account-methods">
      <tbody>
        {{ $vm := . }}{{ range .Passkeys }}<tr>
          <th scope="row">{{ .Name }}</th>
          <td>Added {{ .Added }}{{ if .Used }}, last used {{ .Used }}{{ end }}</td>
          <td><form method="post" action="/account/passkeys/remove">
            <input type="hidden" name="return_to" value="{{ $vm.ReturnURL }}">
            <input type="hidden" name="csrf" value="{{ $vm.Account.CSRF }}">
            <input type="hidden" name="id" value="{{ .ID }}">
            <button class="btn btn-sm" type="submit" aria-label="Remove the passkey {{ .Name }}">Remove</button>
          </form></td>
        </tr>{{ end }}
      </tbody>
    </table>{{ end }}
    <div class="form-group" data-passkey-ui hidden>
      <label class="form-label" for="account-passkey-name">Name for a new passkey</label>
      <input class="form-input" id="account-passkey-name" maxlength="60" placeholder="Such as Laptop or Phone" data-passkey-name>
    </div>
    <div class="settings-actions" data-passkey-ui hidden><button class="btn" type="button" data-passkey="register">Add a passkey</button></div>
    <p class="form-error" role="alert" data-passkey-status hidden></p>
    <noscript><p class="card-desc">Adding a passkey requires JavaScript.</p></noscript>
  </section>{{ end }}

  <section class="card settings-card">
    <h2 class="card-title">Browser data</h2>
    <p class="card-desc">Your anonymous pins and preferences are kept separately. You can merge them into this account when you choose.</p>
    <div class="settings-actions"><button type="button" class="btn" data-account-import hidden>Import this browser's anonymous data</button></div>
    <noscript><p class="card-desc">Importing existing browser data and live reading synchronization require JavaScript. Account export and management work without it.</p></noscript>
  </section>

  <section class="card settings-card">
    <h2 class="card-title">Account data</h2>
    <p class="card-desc">YAVCHN never sees a password. It keeps no GitHub access token, and it does not connect to your HN or Lobsters account.</p>
    <div class="settings-actions"><a class="btn" href="/account/export" download="yavchn-account.json">Export your account data</a></div>
  </section>

  <section class="card settings-card">
    <h2 class="card-title">Sign-in sessions</h2>
    <p class="card-desc">You have {{ .OtherSessions }} other active sign-in sessions. Sessions expire after 30 days.</p>
    <div class="settings-actions">
      {{ if .OtherSessions }}<form method="post" action="/account/sessions">
        <input type="hidden" name="return_to" value="{{ .ReturnURL }}">
        <input type="hidden" name="csrf" value="{{ .Account.CSRF }}">
        <button class="btn" type="submit">Sign out other devices</button>
      </form>{{ end }}
      <form method="post" action="/account/session">
        <input type="hidden" name="return_to" value="{{ .ReturnURL }}">
        <input type="hidden" name="csrf" value="{{ .Account.CSRF }}">
        <button class="btn" type="submit">Sign out this browser</button>
      </form>
    </div>
  </section>

  <section class="card settings-card">
    <h2 class="card-title">Delete your account</h2>
    <p class="card-desc">This permanently deletes your account, synchronized data, picture, passkeys, and active sessions. Your anonymous browser data remains available.</p>
    {{ if .RecentLogin }}<div class="settings-actions"><button class="btn" type="button" commandfor="account-delete-dialog" command="show-modal">Delete my account&hellip;</button></div>
    <dialog class="dialog" id="account-delete-dialog" aria-labelledby="account-delete-title">
      <h3 class="dialog-title" id="account-delete-title">Delete your YAVCHN account?</h3>
      <div class="dialog-body"><p>Your account, its synchronized data, picture, passkeys, and sessions are deleted for good. This cannot be undone.</p></div>
      <form class="dialog-actions" method="post" action="/account">
        <input type="hidden" name="return_to" value="{{ .ReturnURL }}">
        <input type="hidden" name="csrf" value="{{ .Account.CSRF }}">
        <input type="hidden" name="confirm" value="delete">
        <button class="btn" type="button" commandfor="account-delete-dialog" command="close">Keep my account</button>
        <button class="btn btn-danger" type="submit"><span class="glyph" style="--glyph: var(--glyph-warning)" aria-hidden="true"></span> Delete my account</button>
      </form>
    </dialog>{{ else }}<p class="card-desc">Sign in again to confirm it is you, then delete the account.</p>
    <div class="settings-actions">
      {{ if and .LoginAvailable .HasGitHub }}<form method="post" action="/auth/github">
        <input type="hidden" name="return_to" value="{{ .ReturnURL }}">
        <button class="btn" type="submit">Sign in again with GitHub</button>
      </form>{{ end }}
      {{ if and .PasskeysAvailable .Passkeys }}<button class="btn" type="button" data-passkey="signin" data-passkey-ui hidden>Sign in again with a passkey</button>{{ end }}
      {{ if and .EmailAvailable .Email }}<form method="post" action="/auth/email">
        <input type="hidden" name="return_to" value="{{ .ReturnURL }}">
        <input type="hidden" name="email" value="{{ .Email }}">
        <button class="btn" type="submit">Email me a sign-in link</button>
      </form>{{ end }}
    </div>{{ end }}
  </section>

  {{ else }}
  <p class="card-desc">Sign in to keep your pinned stories, collections, notes, blocked domains, and reading progress across devices. You can keep reading without an account.</p>
  {{ if or .LoginAvailable .EmailAvailable }}
  <section class="card settings-card">
    <h2 class="card-title">Sign in</h2>
    <div class="settings-actions">
      {{ if .LoginAvailable }}<form method="post" action="/auth/github">
        <input type="hidden" name="return_to" value="{{ .ReturnURL }}">
        <button class="btn btn-primary" type="submit">Sign in with GitHub</button>
      </form>{{ end }}
      {{ if .PasskeysAvailable }}<button class="btn" type="button" data-passkey="signin" data-passkey-ui hidden>Sign in with a passkey</button>{{ end }}
    </div>
    <p class="form-error" role="alert" data-passkey-status hidden></p>
    <p class="card-desc">GitHub sign-in shares only your public GitHub identity, with no access to your repositories.</p>
  </section>
  {{ if .EmailAvailable }}<section class="card settings-card">
    <h2 class="card-title">Sign in with an email link</h2>
    <form method="post" action="/auth/email">
      <input type="hidden" name="return_to" value="{{ .ReturnURL }}">
      <div class="form-group">
        <label class="form-label" for="account-email">Email address</label>
        <input class="form-input" id="account-email" type="email" name="email" autocomplete="email" maxlength="254" required{{ if eq .Message.Kind "danger" }}{{ if eq .Message.Place "email" }} aria-invalid="true" aria-describedby="account-email-notice"{{ end }}{{ end }}>
        <p class="form-help">YAVCHN sends a link that signs you in, and creates an account the first time. There is no password.</p>
      </div>
      <div class="settings-actions"><button class="btn" type="submit">Email me a link</button></div>
      <div id="account-email-notice">{{ template "accountnotice" (.NoticeAt "email") }}</div>
    </form>
  </section>{{ end }}
  <p class="card-desc">YAVCHN does not connect to your HN or Lobsters account.</p>
  <p class="card-desc">Signing in means you accept the <a href="/terms" data-win-open="terms">terms of use</a>. The <a href="/privacy" data-win-open="privacy">privacy policy</a> says what YAVCHN keeps about you.</p>
  {{ else }}<p role="status">Sign-in is not available yet. You can keep using YAVCHN without signing in.</p>{{ end }}
  {{ end }}
</div>
{{ end }}

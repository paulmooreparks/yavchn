<!doctype html>
<html lang="en">
<head>
{{ template "head" . }}
</head>
<body class="{{ if .WindowView }}desktop{{ else }}classic-list{{ end }}" data-view="{{ .View }}">
{{ template "topbar" . }}

<div class="md-layout" data-md-pane="{{ if and .WindowView .Win.Shown }}detail{{ else }}list{{ end }}">
  <script>
    /* The list's width is the reader's, applied as the layout is parsed so
       the page never draws at the default first, and saved whenever
       pudl-md.js reports a change. */
    (function (layout) {
      try {
        var w = localStorage.getItem('yavchn-sidebar-w');
        if (w) layout.style.setProperty('--md-sidebar-w', w);
        layout.addEventListener('pudl:md-resize', function (e) {
          if (e.detail.reset) localStorage.removeItem('yavchn-sidebar-w');
          else localStorage.setItem('yavchn-sidebar-w', e.detail.width + 'px');
        });
      } catch (e) { /* storage blocked: the default width serves */ }
    })(document.currentScript.parentElement);
  </script>

  <div class="md-toolbar site-listbar" data-region="listbar">
    {{ if or (eq .Source "hn") (eq .Source "lobsters") }}
    <button id="feed-refresh" class="icon-btn feed-refresh" type="button" aria-label="Refresh {{ .SourceLabel }} feed" title="Refresh {{ .SourceLabel }} feed" hidden></button>
    <span class="feed-refresh-status visually-hidden" role="status" hidden></span>
    {{ end }}
    {{ if .Finder }}
    <form class="md-filter-group find-form" action="/find" method="get" role="search">
      <input type="hidden" name="view" value="{{ $.View }}">
      <input class="md-filter" type="search" name="url" value="{{ .FindURL }}" placeholder="Paste a link to find its discussions&hellip;" aria-label="The link to find discussions of" autocomplete="off" spellcheck="false">
      <button class="icon-btn md-filter-go" type="submit" aria-label="Find its discussions"></button>
    </form>
    {{ else }}
      {{ if .ShowSearch }}
      <form class="md-filter-group" action="/hn/search" method="get" role="search">
        <input type="hidden" name="view" value="{{ $.View }}">
      <input class="md-filter" type="search" name="q" value="{{ .Query }}" placeholder="Search Hacker News&hellip;" aria-label="Search Hacker News" autocomplete="off">
        <button class="icon-btn md-filter-go" type="submit" aria-label="Search"></button>
      </form>
      {{ end }}
      {{ if .Tabs }}
      <nav class="seg sm list-tabs" data-seg-menu aria-label="{{ .SourceLabel }} lists">
        {{ range .Tabs }}<a href="{{ .URL }}"{{ if .Active }} aria-current="page"{{ end }}>{{ .Label }}</a>{{ end }}
      </nav>
      {{ end }}
      {{ with .Pin }}
      <form class="md-filter-group pin-filter" action="/pinned/" method="get" role="search">
        <input type="hidden" name="view" value="{{ $.View }}">
      <input class="md-filter" type="search" name="q" value="{{ .Q }}" placeholder="Filter pinned stories&hellip;" aria-label="Filter pinned stories by title, site or author" autocomplete="off">
        {{ if .Source }}<input type="hidden" name="source" value="{{ .Source }}">{{ end }}
        {{ if .Unread }}<input type="hidden" name="show" value="unread">{{ end }}
        {{ if .Sort }}<input type="hidden" name="sort" value="{{ .Sort }}">{{ end }}
        <button class="icon-btn md-filter-go" type="submit" aria-label="Apply the filter"></button>
      </form>
      <nav class="seg sm" data-seg-menu aria-label="Source">{{ range .Sources }}<a href="{{ .URL }}"{{ if .Current }} aria-current="page"{{ end }}>{{ .Label }}</a>{{ end }}</nav>
      <nav class="seg sm" data-seg-menu aria-label="Show">{{ range .Shows }}<a href="{{ .URL }}"{{ if .Current }} aria-current="page"{{ end }}>{{ .Label }}</a>{{ end }}</nav>
      <span class="md-toolbar-sep" aria-hidden="true"></span>
      <nav class="seg sm" data-seg-menu aria-label="Order">{{ range .Sorts }}<a href="{{ .URL }}"{{ if .Current }} aria-current="page"{{ end }}>{{ .Label }}</a>{{ end }}</nav>
      {{ end }}
    {{ end }}
  </div>

  {{/* The filters in force, as chips, each removing its filter. Every list
       renders the row, empty but for Pinned, since a region swap needs a
       counterpart on every page; PUDL hides a row with no chips. */}}
  <div class="md-chips" data-region="chips">
    {{ with .Pin }}{{ if .Chips }}
      {{ range .Chips }}<span class="filter-chip"><span class="filter-chip-kind">{{ .Kind }}</span> {{ .Label }}<a class="filter-chip-x" href="{{ .RemoveURL }}" aria-label="Remove the filter {{ .Label }}"></a></span>{{ end }}
      <a class="md-chips-clear" href="{{ .ClearURL }}">Clear the filters</a>
    {{ end }}{{ end }}
  </div>

  <div class="md-body">
    <nav class="md-sidebar story-list" id="story-list" data-region="list" data-source="{{ .Source }}"{{ if and .Finder .Stories }} data-auto-open{{ end }}{{ with .Pin }} data-pin-q="{{ .Q }}" data-pin-source="{{ .Source }}" data-pin-sort="{{ .Sort }}"{{ if .Unread }} data-pin-unread{{ end }}{{ end }} aria-label="Stories">
      {{ if .ListError }}
      <div class="notice danger list-notice" role="alert">
        <div class="notice-content">
          <p class="notice-title">This list is unavailable</p>
          <p class="notice-body">{{ .ListError }}</p>
          <div class="notice-actions"><a class="btn btn-sm" href="{{ .RetryURL }}">Try again</a></div>
        </div>
      </div>
      {{ else }}
        {{ if .FindNote }}
        <div class="empty-state list-empty">
          <p class="empty-state-title">Nothing found</p>
          <p class="empty-state-body">{{ .FindNote }}</p>
        </div>
        {{ end }}
        <div class="stories" data-has-next="{{ if .HasNext }}true{{ else }}false{{ end }}">
        {{ range .Stories }}
          {{ if .Section }}<div class="md-section-label">{{ .Section }}</div>{{ end }}
          <div class="md-row story-row" id="row-{{ .Key }}" data-key="{{ .Key }}" data-id="{{ .ID }}" data-source="{{ .Source }}" data-url="{{ .URL }}" data-host="{{ .Host }}" data-by="{{ .By }}" data-score="{{ .Score }}" data-comments="{{ .Comments }}">
            <a class="md-item" href="{{ .PageURL }}" data-win-open="{{ .Key }}">{{ .Title }}<span class="md-meta num">{{ if $.Finder }}{{ if .Where }}{{ .Where }} &middot; {{ end }}{{ else }}{{ .Rank }}. {{ .Host }} &middot; {{ end }}{{ .Score }} points{{ if .By }} &middot; {{ .By }}{{ end }} &middot; {{ .Age }} &middot; {{ .Comments }} comments</span></a>
            <div class="story-row-actions">
              <button type="button" class="icon-btn story-pin" aria-pressed="false" aria-label="Pin this story" title="Pin this story"></button>
              <button type="button" class="icon-btn story-hide" aria-label="Hide this story" title="Hide this story"></button>
            </div>
          </div>
        {{ end }}
        </div>
        <div class="story-hidden" hidden><button type="button" class="btn btn-sm story-show-hidden">Show the hidden stories</button></div>
        {{ if or .HasPrev .HasNext }}
        <nav class="pagination story-pager" aria-label="Pages of stories">
          {{ if .HasPrev }}<a class="page-link" href="{{ .PrevURL }}" rel="prev">Previous</a>{{ else }}<a class="page-link" rel="prev" aria-disabled="true">Previous</a>{{ end }}
          <span class="pagination-summary">Page {{ .Page }}</span>
          {{ if .HasNext }}<a class="page-link" href="{{ .NextURL }}" rel="next">Next</a>{{ else }}<a class="page-link" rel="next" aria-disabled="true">Next</a>{{ end }}
        </nav>
        {{ end }}
      {{ end }}
    </nav>
    {{ if .WindowView }}<div class="md-resize" role="separator" aria-orientation="vertical" aria-label="Resize the story list"></div>
    <div class="md-detail reader-stage" tabindex="0">
      <div class="reader-col">
        <main class="win-host">
          <div class="reader-empty" data-region="intro">
            {{ if .Finder }}
            <div class="card welcome-card">
              <h1>Find the conversation behind a link</h1>
              <p>Paste a link into the box above. YAVCHN looks it up on Hacker News and Lobsters and lists every submission of it, including the times the same article was posted years apart.</p>
              <p>Each submission opens in a window holding the article and that submission's discussion, so you can read one thread beside another.</p>
            </div>
            {{ else }}
            <div class="card welcome-card">
              <h1>Pick a story from the list</h1>
              <p>Each story opens in a reader window. Choose Article, Discussion, or Split to make room for what you want to read. In Split, drag the divider to adjust the panes.</p>
              <p>Open several and switch between them from the taskbar at the bottom of the workspace, or drag them side by side. The arrangement lives in the address, so a bookmark brings it back, and changing lists or sources leaves the windows where they are.</p>
              <p>Press <kbd>?</kbd> for the keyboard, or open the Help menu.</p>
            </div>
            {{ end }}
          </div>
          <div class="win-layer" data-win-layer data-win-src="/window/{key}" data-win-menu{{ if .Win.LayerStyle }} style="{{ .Win.LayerStyle }}"{{ end }}>
            {{ range .Win.List }}{{ template "window" . }}{{ end }}
          </div>
        </main>
      </div>
    </div>
    {{ end }}
  </div>
  {{ if .WindowView }}
        <div class="win-bar">
          <button class="icon-btn sidebar-toggle" type="button" aria-controls="story-list" data-focus-toggle aria-label="Hide sidebar" title="Hide sidebar" aria-expanded="true" hidden><svg viewBox="0 0 16 16" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="1.4"><rect x="1.5" y="2" width="13" height="12" rx="1.5"/><path class="sidebar-glyph-pane" d="M2 3h3v10H2z" stroke="none"/><path d="M5.5 2v12"/></svg></button>
          <button class="icon-btn taskbar-scroll" type="button" data-taskbar-scroll="-1" aria-label="Earlier open windows" hidden>‹</button>
          <nav class="win-dock win-bar-dock" data-win-dock aria-label="Open windows"></nav>
          <button class="icon-btn taskbar-scroll" type="button" data-taskbar-scroll="1" aria-label="More open windows" hidden>›</button>
          <a class="icon-btn min-all" data-win-back href="{{ .Win.MinAllHref }}"{{ if not .Win.Shown }} aria-disabled="true"{{ end }} aria-label="Minimize all windows"><svg viewBox="0 0 16 16" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="1.6"><rect x="1.5" y="1.5" width="13" height="9" rx="1.5"/><line x1="4.5" y1="14" x2="11.5" y2="14"/><path d="M6 5.5l2 2 2-2"/></svg></a>
          <a class="icon-btn restore-all" data-win-restore href="{{ .Win.RestoreAllHref }}"{{ if not .Win.AnyMin }} aria-disabled="true"{{ end }} aria-label="Restore all windows"><svg viewBox="0 0 16 16" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="1.6"><rect x="1.5" y="1.5" width="13" height="9" rx="1.5"/><line x1="4.5" y1="14" x2="11.5" y2="14"/><path d="M6 7.5l2-2 2 2"/></svg></a>
          <a class="icon-btn close-all" data-close-all href="{{ .Win.CloseAllHref }}"{{ if not .Win.Open }} aria-disabled="true" tabindex="-1"{{ end }} aria-label="Close all windows"><svg viewBox="0 0 16 16" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="1.6"><rect x="1.5" y="4.5" width="9" height="9" rx="1.5"/><path d="M5.5 4V3a1.5 1.5 0 0 1 1.5-1.5h6A1.5 1.5 0 0 1 14.5 3v6A1.5 1.5 0 0 1 13 10.5h-1"/><line x1="4" y1="7" x2="8" y2="11"/><line x1="8" y1="7" x2="4" y2="11"/></svg></a>
        </div>
  {{ end }}
</div>

{{ template "dialogs" . }}
{{ template "scripts" . }}
</body>
</html>

{{/* Settings, after parkscomputing.com's: a column of PUDL cards, one for
     each choice, each with its title, a line saying what it does, and its
     control. Every choice applies only to this browser and saves at once. */}}
{{ define "settings" }}
<div class="settings-panel" data-settings>
  <section class="card">
    <h2 class="card-title">Theme</h2>
    <fieldset data-settings-js disabled>
      <legend class="visually-hidden">Theme</legend>
      <div class="seg">
        <button type="button" data-setting="theme" value="light" aria-pressed="false">Light</button>
        <button type="button" data-setting="theme" value="dark" aria-pressed="false">Dark</button>
        <button type="button" data-setting="theme" value="system" aria-pressed="false">Follow the system</button>
      </div>
    </fieldset>
  </section>
  <section class="card">
    <h2 class="card-title">View</h2>
    <p class="card-desc">The view a link opens in when it does not name one. The page you are on stays open.</p>
    <form action="/settings/view" method="post" class="settings-view-form" data-saved-view="{{ .SettingsView }}">
      <input type="hidden" name="target" value="/settings">
      <fieldset>
        <legend class="visually-hidden">Default browsing view</legend>
        <div class="seg">
          <button type="submit" name="view" value="window" aria-pressed="{{ eq .SettingsView "window" }}">Windowed</button>
          <button type="submit" name="view" value="classic" aria-pressed="{{ eq .SettingsView "classic" }}">Classic</button>
        </div>
      </fieldset>
    </form>
  </section>
  <section class="card">
    <h2 class="card-title">New article windows</h2>
    <p class="card-desc">How a new reader opens. Open windows keep their placement, and a narrow screen always maximizes readers.</p>
    <form action="/settings/reader-placement" method="post" class="settings-placement-form">
      <fieldset>
        <legend class="visually-hidden">New article windows</legend>
        <div class="seg">
          <button type="submit" name="placement" value="floating" aria-pressed="{{ eq .SettingsPlacement "floating" }}">Floating</button>
          <button type="submit" name="placement" value="maximized" aria-pressed="{{ eq .SettingsPlacement "maximized" }}">Maximized</button>
        </div>
      </fieldset>
    </form>
  </section>
  <section class="card">
    <h2 class="card-title">Comments</h2>
    <p class="card-desc">The order a discussion opens in. Each discussion's own sort buttons change it there.</p>
    <fieldset data-settings-js disabled>
      <legend class="visually-hidden">Default comment order</legend>
      <div class="seg">
        <button type="button" data-setting="sort" value="best" aria-pressed="false">Best first</button>
        <button type="button" data-setting="sort" value="newest" aria-pressed="false">Newest first</button>
        <button type="button" data-setting="sort" value="oldest" aria-pressed="false">Oldest first</button>
      </div>
    </fieldset>
  </section>
  <section class="card">
    <h2 class="card-title">Blocked domains</h2>
    <fieldset data-settings-js disabled>{{ template "domainfilters" "settings" }}</fieldset>
  </section>
  <section class="card" id="browser-data" data-migration>
    <h2 class="card-title">Move your browser data</h2>
    {{/* migration.js shows the half that belongs to the site the reader is
         on: saving a backup on the old domain, importing one elsewhere. */}}
    <div data-migration-leaving hidden>
      <p class="card-desc">YAVCHN is now available on <a href="https://yavchn.com/">yavchn.com</a>, and each domain has its own browser storage. Save a backup of your pinned stories, reading history, blocked domains, theme, and saved applet state here, then open yavchn.com and import it. The file stays on your device, and your data here stays intact. Browsing view and new-window placement must be chosen again.</p>
      <div class="settings-actions">
        <button class="btn" type="button" data-migration-export disabled>Save browser data to a file</button>
        <a class="btn btn-primary" href="https://yavchn.com/settings?migration=1#browser-data">Continue to yavchn.com</a>
      </div>
    </div>
    <div data-migration-import hidden>
      <p class="card-desc">If you used YAVCHN at yavchn.parkscomputing.com, open its Settings there and save a backup file, then choose that file here. The file is read on your device and never uploaded. Import replaces entries with matching names, including whole lists of pinned and visited stories, and keeps the rest. Browsing view and new-window placement must be chosen again.</p>
      <div class="form-group">
        <label class="form-label" for="migration-file">Choose a YAVCHN backup file</label>
        <input class="form-input" id="migration-file" type="file" accept="application/json,.json" data-migration-file disabled>
      </div>
      <p class="card-desc" data-migration-preview></p>
      <div class="settings-actions"><button class="btn btn-primary" type="button" data-migration-apply disabled>Import browser data</button></div>
    </div>
    <p role="status" aria-live="polite" data-migration-status></p>
    <noscript><p class="card-desc">Saving and importing browser data requires JavaScript.</p></noscript>
  </section>
  <noscript><p class="card-desc">Theme, comment order, and blocked domains need JavaScript to reach this browser's preferences.</p></noscript>
  <p class="settings-status" role="status" aria-live="polite"></p>
</div>
{{ end }}

{{ define "domainfilters" }}
<div data-domain-filters>
  <p>Stories from these domains are hidden from every list. Subdomains match too: blocking <code>substack.com</code> also hides <code>danluu.substack.com</code>.</p>
  <ul class="filters-list" aria-label="Blocked domains"></ul>
  <p class="filters-empty" hidden>No domains are blocked.</p>
  <form class="filters-add">
    <label class="form-label" for="{{ . }}-filters-input">Block a domain</label>
    <div class="filters-add-row">
      <input class="form-input" id="{{ . }}-filters-input" type="text" name="domain" placeholder="example.com" autocomplete="off" spellcheck="false" required>
      <button class="btn" type="submit">Block</button>
    </div>
  </form>
</div>
{{ end }}

# Copy to a private file, such as .env.beta, and fill in the OAuth registration.
# Deploy with ./build.ps1 -Target Beta -AuthEnvFile .env.beta
YAVCHN_GITHUB_CLIENT_ID=
YAVCHN_GITHUB_CLIENT_SECRET=
# Email sign-in links, sent through Resend from an address on a domain verified there.
# Leave both empty to offer GitHub and passkeys only.
YAVCHN_RESEND_API_KEY=
YAVCHN_EMAIL_FROM=YAVCHN <signin@yavchn.com>
